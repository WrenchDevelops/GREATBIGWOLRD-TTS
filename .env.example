# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security (optional). When set, require: Authorization: Bearer <API_KEY>
API_KEY=

# CORS: comma-separated origins, or * for all. Empty disables CORS middleware.
ALLOWED_ORIGINS=

# TTS defaults / limits
DEFAULT_VOICE=af_heart
DEFAULT_FORMAT=mp3
MAX_TEXT_LENGTH=2000
MIN_SPEED=0.5
MAX_SPEED=2.0
REQUEST_TIMEOUT_SECONDS=120

# Concurrency for 8 vCPU / 8 GB (recommended: 2)
MAX_CONCURRENT_TTS=2
TORCH_NUM_THREADS=3
TORCH_NUM_INTEROP_THREADS=1

# Disk cache (works without a volume; mount /app/cache for persistence)
CACHE_ENABLED=true
CACHE_DIR=/app/cache
CACHE_MAX_BYTES=2147483648

# Model
MODEL_REPO=hexgrad/Kokoro-82M
SAMPLE_RATE=24000
