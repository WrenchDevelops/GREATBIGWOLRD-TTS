# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security (optional). When set, require: Authorization: Bearer <API_KEY>
API_KEY=

# CORS: comma-separated origins, or * for all. Empty disables CORS middleware.
ALLOWED_ORIGINS=

# TTS defaults / limits
DEFAULT_VOICE=af_heart
DEFAULT_FORMAT=mp3
MAX_TEXT_LENGTH=2000
MIN_SPEED=0.5
MAX_SPEED=2.0
REQUEST_TIMEOUT_SECONDS=120

# Concurrency: keep at 1 (one ONNX session is not safe for overlapping Run)
MAX_CONCURRENT_TTS=1
ONNX_NUM_THREADS=4

# Disk cache (works without a volume; mount /app/cache for persistence)
CACHE_ENABLED=true
CACHE_DIR=/app/cache
CACHE_MAX_BYTES=536870912

# Model
MODEL_PATH=/models/kokoro-v1.0.onnx
VOICES_PATH=/models/voices-v1.0.bin
SAMPLE_RATE=24000
